# Konfigurasi Caku (Catatan Keuangan)

# Database SQLite (pure Go, tanpa CGO)
CAKU_DB_PATH=data/caku.db

# Port Web Dashboard
CAKU_PORT=8080

# Kredensial Login Web Dashboard
CAKU_WEB_USER=admin
CAKU_WEB_PASS=caku123

# Database Google Sheets (Setiap pengetikan di Telegram/Web langsung masuk ke Google Sheet Anda)
# Cara dapatkan URL: Buat spreadsheet -> Extensions -> Apps Script -> Paste template dari dashboard -> Deploy as Web App
GOOGLE_SHEET_WEBAPP_URL=

# Token Bot Telegram dari @BotFather
# Dapatkan dari Telegram: cari @BotFather -> /newbot -> paste token di bawah:
TELEGRAM_BOT_TOKEN=
